{
  "name": "goto-call-review-mcp",
  "version": "0.1.0",
  "description": "Local read-only GoTo Connect call-history MCP",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "goto-mcp": "src/server.mjs",
    "goto-auth": "src/auth.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "test/",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "auth": "node src/auth.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cabadsword/goto-mcp.git"
  },
  "homepage": "https://github.com/cabadsword/goto-mcp",
  "bugs": {
    "url": "https://github.com/cabadsword/goto-mcp/issues"
  }
}
